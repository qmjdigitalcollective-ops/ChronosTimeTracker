{
  "name": "time-tracker",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "build:desktop": "ng build --base-href ./ --output-path dist/desktop",
    "desktop": "npm run build:desktop && electron .",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:win": "npm run build:desktop && electron-builder --win"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^25.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.auraviacollective.timetracker",
    "productName": "Auravia Time Tracker",
    "files": [
      "electron/**/*",
      "dist/desktop/**/*"
    ],
    "mac": {
      "icon": "public/icon-512.png",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "public/icon-512.png",
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
